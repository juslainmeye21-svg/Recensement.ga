<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Inscription citoyen</title>
  <script>
    function verifierAge() {
      const nom = document.getElementById("nom").value;
      const prenom = document.getElementById("prenom").value;
      const dateNaissance = new Date(document.getElementById("date_naissance").value);
      const numeroId = document.getElementById("numero_id").value;

      const today = new Date();
      let age = today.getFullYear() - dateNaissance.getFullYear();
      const m = today.getMonth() - dateNaissance.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < dateNaissance.getDate())) {
        age--;
      }

      if (age < 18) {
        alert("Tu n'as pas encore 18 ans, enregistrement refusé.");
      } else {
        window.location.href = "confirmation.html";
      }
    }
  </script>
</head>
<body>
  <h1>Inscription citoyen</h1>
  <form onsubmit="event.preventDefault(); verifierAge();">
    <label>Nom :</label>
    <input type="text" id="nom" required><br>

    <label>Prénom :</label>
    <input type="text" id="prenom" required><br>

    <label>Date de naissance :</label>
    <input type="date" id="date_naissance" required><br>

    <label>Numéro de carte d'identité :</label>
    <input type="text" id="numero_id" required><br>

    <button type="submit">S'enregistrer</button>
  </form>
</body>
</html>
